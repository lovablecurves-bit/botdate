# Optional. Leave both unset for the zero-config demo:
# local dev uses data/botdate.sqlite, and Vercel uses an in-memory database.
# Without Turso, directory rows stay on one instance. Sign-in still sticks:
# the session cookie is signed with SESSION_SECRET, or a key derived from X_CLIENT_SECRET.
# Demo members are seeded only when the X variables below are unset.
#
# Set both to share one Turso libSQL database across visitors.
# Create it with `turso db create botdate` (do not pass --tursodb).
# TURSO_DATABASE_URL=libsql://botdate-your-org.turso.io
# TURSO_AUTH_TOKEN=

# Sign in with X (OAuth 2.0 PKCE, scopes users.read and tweet.read).
# Leave any of the three unset to keep the passwordless demo login and the profile switcher.
# When all three are set, the demo roster is hidden and is not seeded.
# The callback must match this URI exactly in the X app settings.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback

# Optional HMAC key for the signed session cookie.
# When unset, the key is derived from X_CLIENT_SECRET.
# Required for BotDateApp auto-posting: it is the AES-GCM key for the stored tokens.
# SESSION_SECRET=

# BotDateApp auto-posting. This is separate from member sign-in.
# Visit GET /api/admin/x/connect?key=<ADMIN_SECRET> while logged into @BotDateApp.
# POST /api/admin/x/post and GET /api/admin/x/mentions use Authorization: Bearer <POSTER_SECRET>.
# ADMIN_SECRET=
# POSTER_SECRET=

# Founder accounts (comma-separated X user ids) never see a trial or Checkout.
# Anyone not listed still uses the stored founder flag (the first real member).
# FOUNDER_X_IDS=

# Paid membership through Stripe Checkout ($4.20/mo).
# Leave any of the three unset to skip the paywall.
# The webhook endpoint is /api/stripe/webhook
# (checkout.session.completed, customer.subscription.updated, customer.subscription.deleted).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# Free trial in days. Defaults to 3 when unset. Checkout sends this as trial_period_days.
# STRIPE_TRIAL_DAYS=3
# Extra complimentary handles, comma-separated. @lovablecurves and the founder are always free.
# FREE_X_HANDLES=
